# SlyxUp Motion — environment
# Copy to .env and fill in. Without a key the app runs in mock auth mode.

# Publishable key from the SlyxUp Auth dashboard (create platform → API keys).
VITE_SLYXUP_PUBLISHABLE_KEY=pk_daed7bd1745655af1ae217c59b848f00c8ccedda006dc429

# Auth API base (default is the shared SlyxUp worker — override only for self-host).
# VITE_SLYXUP_API_URL=https://auth-slyxup-com.auth-0f4.workers.dev

# Platform/project id used for password reset + OAuth return URLs.
VITE_SLYXUP_PROJECT_ID=b52a7938-ec8d-4fdb-87fe-03d8d1d7ff4c

# Backend API (local). Enables the real Gemini director.
VITE_API_URL=http://localhost:8787
