# Loaded by `vite build`, i.e. the Pages deployment.
#
# Production is split across two domains — the frontend is Pages, the agent is
# the Worker — so the client is told where to open the WebSocket. CORS on the
# Worker side is configured in backend/src/server.ts and must allow this origin.
VITE_API_HOST=slyxup-motion-api.slyxup-smarketing.workers.dev
# SlyxUp Stack — publishable config only (public by design; secrets never get VITE_ prefix).
VITE_SLYXUP_PUBLISHABLE_KEY=pk_4fe385f0e6e8448df10679fb30183cf37c5ff4467ab3fd0b
VITE_SLYXUP_API_URL=https://auth-slyxup-com.auth-0f4.workers.dev
VITE_SLYXUP_BILLING_URL=https://billing-slyxup-com.billing-86c.workers.dev
VITE_SLYXUP_PROJECT_ID=b52a7938-ec8d-4fdb-87fe-03d8d1d7ff4c