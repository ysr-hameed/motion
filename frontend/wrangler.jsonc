{
  // Pages deploy config for the FRONTEND.
  //
  // The backend lives in the `motion` account (see backend/wrangler.jsonc);
  // this project is the static bundle and is deployed to Pages in the main
  // Slyxup account. Keeping the two configs separate is what makes that
  // split explicit — a shared config would send one of them to the wrong
  // account, where the D1/R2/KV bindings do not exist.
  //
  // NOTE: Pages rejects "account_id" in config, so the target account is
  // passed as CLOUDFLARE_ACCOUNT_ID (see the deploy script in package.json).
  // This login can see six accounts and wrangler refuses to guess.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motion-frontend",
  "compatibility_date": "2026-09-27",
  "pages_build_output_dir": "dist"
}