# SlyxUp Motion frontend — environment

# .env = local dev (`vite dev`). Production builds use `.env.production`.
# Backend API base. When set and reachable, AI calls go to the real
# director; otherwise the app falls back to local simulation.
VITE_API_URL=http://localhost:8787

# SlyxUp Stack auth (same keys as the backend dashboard platform).
VITE_SLYXUP_PUBLISHABLE_KEY=
VITE_SLYXUP_PROJECT_ID=
