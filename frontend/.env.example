# Backend Worker host as "host:port" or a full origin.
#
# Development only. `pnpm dev` proxies /agents and /api to the Worker on 8787,
# so the browser sees a single origin and this stays EMPTY.
#
# The production value lives in .env.production, where the frontend and the
# Worker are genuinely on different domains.
VITE_API_HOST=

# SlyxUp Stack — public config (VITE_* ships in the bundle; never put sk_* here).
VITE_SLYXUP_PUBLISHABLE_KEY=pk_REPLACE_WITH_REAL_KEY
VITE_SLYXUP_API_URL=https://auth-slyxup-com.auth-0f4.workers.dev
VITE_SLYXUP_BILLING_URL=https://billing-slyxup-com.billing-86c.workers.dev
VITE_SLYXUP_PROJECT_ID=REPLACE_WITH_PROJECT_ID