{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slyxup-motion",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],

  // The chat loop, its transcript and stream state all live inside this
  // Durable Object. That is the whole point of the rewrite: a request no
  // longer carries the conversation, so Worker CPU per request stays flat
  // however long the thread gets.
  "durable_objects": {
    "bindings": [{ "name": "Chat", "class_name": "Chat" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Chat"] }],

  "observability": { "enabled": true },

  // The Worker serves the built frontend, so the browser sees ONE origin in
  // production — no CORS anywhere. Build the frontend before deploying the
  // Worker. run_worker_first keeps /agents/* on the Worker.
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "vars": {
    // Comma-separated fallback chain, tried in order. Vercel AI Gateway ids.
    "AI_MODEL": "alibaba/qwen3.7-flash"
  }
}