{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Same name as the previous backend, so deploying REPLACES it instead of
  // creating a second Worker. Do not rename casually.
  "name": "slyxup-motion-api",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],

  // This login can see six accounts (motion, auth, billing, prompt, soffice and
  // the main Slyxup account) and wrangler refuses to guess which one to deploy
  // to in non-interactive mode. Pinned explicitly for that reason.
  "account_id": "ff5e7d6dcf3eb86cd796263fbb3f0872",

  // The chat loop, its transcript and stream state all live inside this
  // Durable Object. A request now carries one new message instead of the whole
  // conversation, so CPU per request stays flat however long the thread gets.
  //
  // No "limits" block on purpose: this account is on Workers Free, which
  // rejects it. It is not needed either. CPU accounting, per the Durable
  // Objects limits page:
  //
  //   * A SQLite-backed DO gets 30s of CPU per invocation by default, and each
  //     incoming WebSocket message resets that budget.
  //   * CPU is ACTIVE time only. Every millisecond spent waiting on the model
  //     gateway, D1 or R2 is I/O and counts for nothing.
  //   * DOs are available on Workers Free.
  //
  // So the Free plan's ~10ms per-request cap applies only to this outer
  // Worker, which does almost nothing: match the URL, forward to the DO,
  // return the response. It never parses a transcript and never waits on the
  // model. That is the whole reason the agent runs inside a DO.
  "durable_objects": {
    "bindings": [{ "name": "Chat", "class_name": "Chat" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Chat"] }],

  "observability": { "enabled": true },

  // Motion product data (auth lives in SlyxUp Stack, not here).
  // NOTE: `slyxup-motion-db` holds pre-rewrite tables and is left untouched;
  // the new schema lives in `slyxup-motion-api`.
  "d1_databases": [
    { "binding": "DB", "database_name": "slyxup-motion-api", "database_id": "c464746d-65ca-4c69-8b56-0111ab46035c" }
  ],
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "f81a2f99d5444b8aacb5a3acd5882523" },
    { "binding": "ASSET_CACHE_KV", "id": "6484918c8ca547d9913070f6d3eaf717" }
  ],
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "motion-assets" },
    { "binding": "EXPORTS_BUCKET", "bucket_name": "motion-exports" }
  ],

  // Public SlyxUp Stack project config (publishable values only — secrets go
  // via `wrangler secret put`: INTERNAL_SECRET + any sk_* / Paddle keys).
  // WORKER_SELF_URL lets the Chat DO call back into /api/internal/*.
  "vars": {
    "WORKER_SELF_URL": "https://slyxup-motion-api.slyxup-smarketing.workers.dev",
    "SLYXUP_AUTH_URL": "https://auth-slyxup-com.auth-0f4.workers.dev",
    "SLYXUP_BILLING_URL": "https://billing-slyxup-com.billing-86c.workers.dev",
    "SLYXUP_PUBLISHABLE_KEY": "pk_4fe385f0e6e8448df10679fb30183cf37c5ff4467ab3fd0b",
    "SLYXUP_PROJECT_ID": "b52a7938-ec8d-4fdb-87fe-03d8d1d7ff4c"
  },

  // The frontend is NOT served from here — it is deployed to Cloudflare Pages
  // and served from motion.slyxup.com, so this Worker serves API + agent only.
  //
  // The model is a single constant in src/chat.ts, not a var: one gateway key
  // with one 5-requests-per-minute quota means a fallback chain would just
  // spend that quota twice as fast. An earlier AI_MODEL var listing
  // "alibaba/qwen3.7-flash,google/gemini-2.0-flash" is gone for that reason.
}