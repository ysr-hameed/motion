{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Same name as the previous backend, so deploying REPLACES it instead of
  // creating a second Worker. Do not rename casually.
  "name": "slyxup-motion-api",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],

  // This login can see six accounts (motion, auth, billing, prompt, soffice and
  // the main Slyxup account) and wrangler refuses to guess which one to deploy
  // to in non-interactive mode. Pinned explicitly for that reason.
  "account_id": "ff5e7d6dcf3eb86cd796263fbb3f0872",

  // The chat loop, its transcript and stream state all live inside this
  // Durable Object. A request now carries one new message instead of the whole
  // conversation, so CPU per request stays flat however long the thread gets.
  //
  // No "limits" block on purpose: this account is on Workers Free, which
  // rejects it. It is not needed either. CPU accounting, per the Durable
  // Objects limits page:
  //
  //   * A SQLite-backed DO gets 30s of CPU per invocation by default, and each
  //     incoming WebSocket message resets that budget.
  //   * CPU is ACTIVE time only. Every millisecond spent waiting on the model
  //     gateway, D1 or R2 is I/O and counts for nothing.
  //   * DOs are available on Workers Free.
  //
  // So the Free plan's ~10ms per-request cap applies only to this outer
  // Worker, which does almost nothing: match the URL, forward to the DO,
  // return the response. It never parses a transcript and never waits on the
  // model. That is the whole reason the agent runs inside a DO.
  "durable_objects": {
    "bindings": [{ "name": "Chat", "class_name": "Chat" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Chat"] }],

  "observability": { "enabled": true },

  // The frontend is NOT served from here — it is deployed to Cloudflare Pages
  // and served from motion.slyxup.com, so this Worker serves API + agent only.

  "vars": {
    // Comma-separated chain, tried in order. Vercel AI Gateway model ids.
    "AI_MODEL": "alibaba/qwen3.7-flash,google/gemini-2.0-flash"
  }
}